---
import {regionalPages} from '../lib/regional-runtime.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import pages from '../lib/all-pages.mjs';
import products from '../data/products.json';
import {site,groups} from '../config/site';
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuide} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['funeral-basic','congrats-basic','funeral-xl','congrats-xl'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={`${site.region} 꽃배달 | 근조·축하화환 ${site.brand}`} description={`${site.region}의 결혼과 새 출발을 축하하고 소중한 인연을 위로하는 꽃이랑. 근조·축하화환을 사진과 가격으로 살펴보고 편하게 상담하세요.`} canonicalPath="/" socialProduct={featured[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>{site.region} 꽃배달,<br/>전할 마음에 맞게 고르세요</h1><p>판교에서 새 사무실을 연 동료의 도전, 위례에서 결혼하는 친구의 앞날, 분당의 빈소로 전하고 싶은 위로. 성남의 소중한 인연에게 꽃으로 마음을 전해 보세요. 실제 상품사진과 가격을 보며 어울릴 꽃을 함께 골라 보실 수 있습니다.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>전달일정·배송비 상담</span></div></div>
 <div class="hero-products" aria-label="근조화환·축하화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원 · 상품 기본가격</strong></span></a>)}</div>
</section>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.filter(g=>g.cat!=='regions').map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuide(g.cat,pages).decision[0]}</span><em>꽃 이야기와 상품 보기 →</em></a>)}</div></section>}
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>근조화환·축하화환을 비교하세요</h2><p>상품 이미지는 실제 판매 구성의 예시이며 지역·계절에 따라 꽃이 달라질 수 있습니다.</p></div><ProductCards products={featured}/></section>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>소중한 분께 전할 꽃 이야기를 만나보세요</h2></div>{groups.filter(g=>g.cat!=='regions').map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
<section class="conversion-panel"><div><span class="eyebrow">꽃이랑과 함께 전하는 마음</span><h2>어떤 날을 위해 꽃을 보내시나요?</h2><p>축하하고 싶은 일과 전할 마음을 편하게 말씀해 주세요. 상품과 예산, 가능한 전달일정을 함께 상담하실 수 있습니다.</p></div><div class="actions"><a class="btn light" href={site.phoneHref}>전화주문</a><a class="btn yellow" href={site.orderUrl}>온라인 주문</a></div></section>
{regionalPages.length>0 && <section class="section"><div class="container"><a href="/regions/">{site.region} 지역별 꽃배달 안내 →</a></div></section>}
</BaseLayout>
