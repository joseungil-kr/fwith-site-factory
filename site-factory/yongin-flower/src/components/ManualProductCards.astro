---
import products from '../data/products.json';
import business from '../data/business-truth.json';
const {category}=Astro.props;
const family=category==='funeral'?'funeral_wreath':'congrats_wreath';
const selected=products.filter(p=>p.category===family).slice(0,2);
---
<section aria-label="상품 선택과 주문"><h2>상품 구성과 표시금액 비교</h2><p>상품 예시이며 해당 장소의 배송 실적 사진이 아닙니다. 표시금액 확인일: 2026년 10월 7일. 추가 배송비와 최종 구성·금액은 주문 시 확인합니다.</p><div class="manual-products">{selected.map(p=><article><img src={p.image} alt={p.imageAlt} width="640" height="640" loading="lazy"/><h3>{p.name}</h3><p>{p.price.toLocaleString('ko-KR')}원</p><a href={business.phoneHref}>이 상품 전화 상담</a> · <a href={business.onlineOrderUrl}>온라인 상품 확인</a></article>)}</div></section>
<style>.manual-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.manual-products article{min-width:0;border:1px solid #e8d9dc;padding:1rem;border-radius:1rem}.manual-products img{width:100%;height:18rem;object-fit:contain}.manual-products a{overflow-wrap:anywhere}@media(max-width:480px){.manual-products{grid-template-columns:1fr}}</style>
