---
import BaseLayout from '../layouts/BaseLayout.astro';
import SharedFlowerBanner from './SharedFlowerBanner.astro';
import ProductCards from './ProductCards.astro';
import {home,detail,copySHA,mapHref,ui} from '../lib/suncheon-runtime.mjs';
const {page:p}=Astro.props;
const c=p.id==='home'?home:detail;
---
<BaseLayout page={p}><article data-page-id={p.id} data-page-role={p.role} data-copy-sha={copySHA[p.id as keyof typeof copySHA]||undefined}>
{['home','article'].includes(p.id)?<div data-reviewed-body>
<section id="opening" class="category-hero"><h1 data-reviewed-block>{c.h1}</h1>{(Array.isArray(c.lead)?c.lead:[c.lead]).map((t:string,i:number)=><p data-reviewed-block data-first-answer={i===0||undefined}>{t}</p>)}</section>
<SharedFlowerBanner variant="message"/>
{p.id==='home'?<>
{home.sections.map((s:any,i:number)=><>{i===1&&<SharedFlowerBanner variant="budget"/>}<section id={`section-${i+1}`} class="content-card copy-section"><h2 data-reviewed-block>{s.h2}</h2><p data-reviewed-block>{s.text}</p>{s.card&&<article class="page-card" data-content-card><h3 data-reviewed-block>{s.card.title}</h3><p data-reviewed-block>{s.card.summary}</p><a data-reviewed-block data-required-cta href={mapHref(s.card.localHref)}>{s.card.ctaLabel}</a></article>}</section></>)}
<SharedFlowerBanner variant="consultation"/>
<div class="actions final-action"><a class="btn dark" data-reviewed-block data-required-cta href={home.cta.href}>{home.cta.label}</a></div>
<section id="sources" class="source-card" data-source-references><h2 data-reviewed-block>{home.sourceHeading}</h2><p data-reviewed-block>{home.sourcesText}</p><a data-reviewed-block href={mapHref(home.sourceLink.localHref)}>{home.sourceLink.label}</a></section>
</>:<>
{detail.sections.map((s:any)=><>{s.id==='facility'&&<SharedFlowerBanner variant="budget"/>}<section id={s.id} class="content-card copy-section"><h2 data-reviewed-block>{s.h2}</h2>{s.paragraphs.map((t:string,i:number)=><><p data-reviewed-block>{t}</p>{s.id==='products'&&i+1===s.productCardsAfterParagraph&&<ProductCards/>}</>)}{s.list&&<ul>{s.list.map((t:string)=><li data-reviewed-block>{t}</li>)}</ul>}{s.afterList?.map((t:string)=><p data-reviewed-block>{t}</p>)}</section></>)}
<section id="faq" class="faq" data-visible-faq><h2 data-reviewed-block>{detail.faqHeading}</h2>{detail.faq.map((f:any)=><div class="faq-pair"><h3 data-reviewed-block data-faq-question>{f.question}</h3><p data-reviewed-block data-faq-answer>{f.answer}</p></div>)}</section>
<SharedFlowerBanner variant="consultation"/>
<div class="directory-closing"><p data-reviewed-block>{detail.closing}</p></div><div class="actions final-action"><a class="btn dark" data-reviewed-block data-required-cta href={detail.cta.href}>{detail.cta.label}</a></div>
<section id="sources" class="source-card" data-source-references><h2 data-reviewed-block>{detail.sourceHeading}</h2><p data-reviewed-block>{detail.sourceIntro}</p><ul>{detail.sources.map((s:any)=><li><a data-reviewed-block href={s.url}>{s.label}</a></li>)}</ul></section>
</>}
</div>:<>
<section id="opening" class="category-hero"><h1>{p.h1}</h1>{p.id==='not-found'&&<p>{ui.notFound.body}</p>}</section>
{p.id==='support'&&<div class="card-grid journey-grid" data-purchase-cards><article class="page-card" data-content-card><h2>{home.sections[0].card.title}</h2><p>{home.sections[0].card.summary}</p><a data-required-cta href={mapHref(home.sections[0].card.localHref)}>{home.sections[0].card.ctaLabel}</a></article></div>}
{p.id==='not-found'&&<div class="actions final-action"><a class="btn dark" data-required-cta href="/">{ui.notFound.ctaLabel}</a></div>}
</>}
</article></BaseLayout>
