---
import SharedFlowerBanner from '../components/SharedFlowerBanner.astro';
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import pages from '../data/pages.json';
import products from '../data/products.json';
import {site,serviceGroups as groups} from '../config/site';
import {groupsFor,assertRegionalInput} from '../lib/regional-runtime.mjs';
assertRegionalInput(pages);
const districts:{key:string;name:string}[]=groupsFor(pages);
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['funeral-basic','funeral-premium','congrats-basic','congrats-premium'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={`${site.region} 꽃배달 | 근조·축하화환 ${site.brand}`} description={`${site.region} 기쁜 날의 축하와 힘든 날의 위로를 꽃으로 전하세요. 근조·축하화환 사진과 가격을 비교하고 꽃이랑에서 편하게 주문 상담하세요.`} canonicalPath="/" socialProduct={heroProducts[0] || products[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>{site.region} 꽃배달,<br/>전하고 싶은 마음을 꽃으로</h1><p>정성껏 꾸민 카페의 첫날부터 오랜 가족과 이웃이 모이는 연회까지, 양평에서 함께 기뻐할 순간을 꽃으로 전해 보세요. 결혼의 축복과 조문의 위로도 받는 분을 생각하며 골라 상담하실 수 있습니다.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>예산에 맞춘 상품 선택</span></div></div>
 <div class="hero-products" aria-label="근조·축하화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원</strong></span></a>)}</div>
</section>
<SharedFlowerBanner variant="message"/>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>상품·주문 준비 보기 →</em></a>)}</div></section>}
{districts.length>0 && <section class="purpose-navigation" data-region-navigation><div class="section-title"><h2>지역별 꽃배달 안내</h2><p>가까운 지역에서 전하는 꽃선물 이야기를 만나보세요.</p></div><div class="purpose-grid">{districts.map(district=><a class="page-card purpose-card" href={`/regions/#${district.key}`}><strong>{district.name}</strong><span>가까운 지역의 꽃선물 안내</span></a>)}</div><a href="/regions/">지역 전체 보기 →</a></section>}
<SharedFlowerBanner variant="budget"/>
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>근조·축하화환 상품과 가격을 비교하세요</h2><p>표시가격은 상품 기본가격입니다. 공식몰에는 양평군 단월면·양서면의 추가 배송비 10,000원이 안내되어 있습니다. 다른 읍·면을 포함한 실제 배송지의 적용 금액은 상담에서 안내받으실 수 있습니다.</p></div><ProductCards products={featured}/></section>
<SharedFlowerBanner variant="consultation"/>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>축하와 위로를 전하는 이야기</h2></div>{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
</BaseLayout>
