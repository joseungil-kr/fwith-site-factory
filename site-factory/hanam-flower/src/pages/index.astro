---
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import pages from '../data/pages.json';
import products from '../data/products.json';
import {site,serviceGroups as groups} from '../config/site';
import {groupsFor,assertRegionalInput} from '../lib/regional-runtime.mjs';
assertRegionalInput(pages);
const districts:{key:string;name:string}[]=groupsFor(pages);
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['funeral-basic','funeral-premium','congrats-basic','congrats-premium'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={`${site.region} 꽃배달 | 근조·축하화환 ${site.brand}`} description={`${site.region}에 전할 축하와 위로의 꽃을 살펴보세요. 꽃이랑 근조·축하화환의 사진과 기본가격을 비교하고 예산에 맞춰 편하게 상담하세요.`} canonicalPath="/" socialProduct={heroProducts[0] || products[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>{site.region} 꽃배달,<br/>마음을 전하는 꽃을 고르세요</h1><p>미사의 새 매장과 동료의 새 배움터에 응원을, 결혼하는 두 분에게 따뜻한 축복을 전해 보세요. 조의를 전할 근조화환도 꽃이랑에서 사진과 기본가격을 비교하며 상담하실 수 있습니다.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>예산·전달 일정 상담</span></div></div>
 <div class="hero-products" aria-label="근조·축하화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원 · 상품 기본가격</strong></span></a>)}</div>
</section>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>상품·주문 준비 보기 →</em></a>)}</div></section>}
{districts.length>0 && <section class="purpose-navigation" data-region-navigation><div class="section-title"><h2>보내실 장소의 꽃 안내</h2><p>미사·덕풍의 개업과 새로운 배움터의 시작, 예식장에서 나누는 축복과 마루공원 빈소에 전할 위로까지. 하남에서 꽃을 보내실 장소와 상황으로 찾아보세요.</p></div><div class="purpose-grid">{districts.map(district=><a class="page-card purpose-card" href={`/regions/#${district.key}`}><strong>{district.name}</strong><span>장소별 상품과 꽃 이야기</span></a>)}</div><a href="/regions/">장소별 꽃 안내 보기 →</a></section>}
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>마음과 예산에 맞는 근조·축하화환</h2><p>고인을 기리는 조의와 기쁜 소식을 축하하는 마음을 담아보세요. 상품 사진부터 살펴보셔도 좋고, 생각하신 예산으로 상담을 시작하셔도 좋습니다.</p></div><ProductCards products={featured}/></section>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>소중한 날에 어울리는 꽃 이야기</h2></div>{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
</BaseLayout>
