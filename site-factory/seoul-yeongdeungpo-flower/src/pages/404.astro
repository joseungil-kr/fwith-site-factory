---
import BaseLayout from '../layouts/BaseLayout.astro';
import approvedCopy from '../data/yeongdeungpo-copy.json';
const copy=approvedCopy.common.notFound;
---
<BaseLayout title={copy.title} description={copy.text} noindex={true} canonicalPath={false} includeSchema={false}><section class="not-found"><h1>{copy.title}</h1><p>{copy.text}</p><a class="btn primary" href={copy.href}>{copy.linkText}</a></section></BaseLayout>
