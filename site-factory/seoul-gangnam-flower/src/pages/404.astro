---
import BaseLayout from '../layouts/BaseLayout.astro';
import approvedCopy from '../data/gangnam-copy.json';
const copy=approvedCopy.common.notFound;
---
<BaseLayout title={copy.title} description={copy.text} noindex={true} canonicalPath={false} includeSchema={false}><section class="not-found"><h1>{copy.h1}</h1><p>{copy.text}</p><a class="btn primary" href={copy.homeHref}>{copy.homeLabel}</a></section></BaseLayout>
