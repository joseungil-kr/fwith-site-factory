{
  "schemaVersion": 1,
  "required": ["siteInstance","sourceRevision","publicOrigin","url","query","publishedAt","observedAt","naverCollected","naverIndexed","resultArea","observedRank"],
  "fields": {
    "siteInstance": "prototype-a | prototype-b | future instance key",
    "sourceRevision": "40-char git sha",
    "publicOrigin": "exact deployed https origin",
    "url": "exact canonical page URL",
    "query": "observed Naver query",
    "publishedAt": "ISO-8601",
    "observedAt": "ISO-8601",
    "naverCollected": "true | false | unknown",
    "naverIndexed": "true | false | unknown",
    "resultArea": "web | smartblock | blog | cafe | ai | other | none",
    "observedRank": "positive integer or null",
    "notes": "free text; duplicate clustering or no-show is a valid result"
  }
}
