---
import BaseLayout from '../../layouts/BaseLayout.astro';
import instances from '../../data/site-instances.json';
import regions from '../../data/regions-matrix.json';
import productGroups from '../../data/product-groups.json';
import sourceProducts from '../../data/product-sources.json';
import config from '../../data/site-config.json';
import {selectInstance,enabledRows,productsFor} from '../../lib/matrix.mjs';
const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
export function getStaticPaths(){
  const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
  return enabledRows(active,regions,productGroups).groups.map((group:any)=>({params:{product:group.slug},props:{group}}));
}
type GroupProp={key:string;slug:string;label:string;shortLabel:string;buyerIntent:string;sourceProductCodes:string[];intro:string;selectionTips:string[];questions:string[]};
const {group}=Astro.props as {group:GroupProp};
const products=productsFor(group,sourceProducts);
const activeRegions=regions.filter((r:any)=>active.enabledRegions.includes(r.key));
const hero=products[0];
---
<BaseLayout title={`${group.label} 지역별 주문 안내 | ${active.brand}`} description={`${group.label} 실제 상품 사진과 가격, 지역별 주문 준비 페이지를 한곳에서 확인하세요.`} canonicalPath={`/products/${group.slug}/`} socialImageUrl={hero.imageUrl} socialImageAlt={hero.imageAlt}>
<nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><span>{group.label}</span></nav>
<section class="category-hero hub-hero"><div><span class="eyebrow">{group.buyerIntent}</span><h1>{group.label} 지역별 주문 안내</h1><p>{group.intro}</p></div></section>
<section class="product-section"><h2>{group.label} 실제 상품과 가격</h2><div class="product-grid">{products.map((p:any)=><article class="product-card"><img src={p.imageUrl} alt={p.imageAlt} loading="lazy" width="500" height="500"/><div><h3>{p.name}</h3><strong>{p.price.toLocaleString()}원</strong><p>상품코드 {p.code} · {p.priceVerifiedAt} 가격 확인</p><a href={p.sourceUrl}>꽃이랑 상품 원문 →</a></div></article>)}</div></section>
<section class="content-card"><h2>상품을 고르기 전에 확인하세요</h2><ul>{group.selectionTips.map((tip:string)=><li>{tip}</li>)}</ul></section>
<section class="card-grid big">{activeRegions.map((region:any)=><a class="page-card" href={`/${region.slug}/${group.slug}/`}><strong>{region.name} {group.label}</strong><span>{region.decisionNote}</span></a>)}</section>
<section class="faq"><h2>{group.label} 자주 묻는 질문</h2><div><h3>지역이 달라도 상품 가격은 같나요?</h3><p>여기에는 꽃이랑 상품 원문에서 확인한 상품 기본가격을 표시합니다. 실제 결제금액은 받는 주소의 추가배송비와 상품 준비 조건을 함께 확인해야 합니다.</p></div><div><h3>원하는 시간에 바로 받을 수 있나요?</h3><p>희망시간을 알려 주시면 지역 배송 상황과 상품 준비 가능 여부를 확인할 수 있습니다. 확인 전 도착시간을 보장하지 않습니다.</p></div></section>
<section class="conversion-panel"><div><span class="eyebrow">{active.brand} {group.label}</span><h2>받을 지역과 수령정보를 정해 주세요</h2><p>상품·주소·수령자·희망시간을 함께 알려 주시면 주문 확인이 빠릅니다.</p></div><div class="actions"><a class="btn light" href={active.phoneHref}>☎ {active.phone} 전화주문</a><a class="btn yellow" href={active.orderUrl}>온라인 주문</a></div></section>
</BaseLayout>
