---
import BaseLayout from '../../layouts/BaseLayout.astro';
import instances from '../../data/site-instances.json';
import regions from '../../data/regions-matrix.json';
import productGroups from '../../data/product-groups.json';
import sourceProducts from '../../data/product-sources.json';
import config from '../../data/site-config.json';
import {selectInstance,enabledRows,productsFor} from '../../lib/matrix.mjs';
const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
export function getStaticPaths(){
  const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
  return enabledRows(active,regions,productGroups).regions.map(region=>({params:{region:region.slug},props:{region}}));
}
const {region}=Astro.props;
const groups=productGroups.filter((g:any)=>active.enabledProductGroups.includes(g.key));
const lead=productsFor(groups[0],sourceProducts)[0];
---
<BaseLayout title={`${region.name} 꽃배달 상품별 안내 | ${active.brand}`} description={`${region.name} 근조화환·개업축하화환·승진취임 난·꽃다발의 실제 상품 가격과 주문 준비를 상품군별로 확인하세요.`} canonicalPath={`/${region.slug}/`} socialImageUrl={lead.imageUrl} socialImageAlt={lead.imageAlt}>
<nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><span>{region.name}</span></nav>
<section class="category-hero hub-hero"><div><span class="eyebrow">{region.name} 꽃배달</span><h1>{region.name} 꽃배달 상품별 안내</h1><p>{region.decisionNote} 목적에 맞는 상품군을 고른 뒤 수령처와 희망시간을 함께 준비하세요.</p></div></section>
<section class="product-grid">{groups.map((g:any)=>{const p=productsFor(g,sourceProducts)[0];return <article class="product-card"><img src={p.imageUrl} alt={p.imageAlt} loading="lazy" width="500" height="500"/><div><h2>{region.name} {g.label}</h2><strong>{p.name} {p.price.toLocaleString()}원부터 확인</strong><p>{g.buyerIntent}</p><a href={`/${region.slug}/${g.slug}/`}>상품·주문 준비 보기 →</a></div></article>})}</section>
<section class="content-card"><h2>{region.name} 배송비 확인</h2><p>{region.deliveryNote}</p></section>
</BaseLayout>
