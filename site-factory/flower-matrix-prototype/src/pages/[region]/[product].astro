---
import BaseLayout from '../../layouts/BaseLayout.astro';
import instances from '../../data/site-instances.json';
import regions from '../../data/regions-matrix.json';
import productGroups from '../../data/product-groups.json';
import sourceProducts from '../../data/product-sources.json';
import config from '../../data/site-config.json';
import {selectInstance,matrixPages,productsFor} from '../../lib/matrix.mjs';
const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
export function getStaticPaths(){
  const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
  return matrixPages(active,regions,productGroups).map(page=>({params:{region:page.region.slug,product:page.group.slug},props:{page}}));
}
const {page}=Astro.props;
const products=productsFor(page.group,sourceProducts);
const hero=products[0];
const siblingGroups=productGroups.filter((g:any)=>active.enabledProductGroups.includes(g.key)&&g.key!==page.group.key);
---
<BaseLayout title={page.title} description={page.description} canonicalPath={page.url} socialImageUrl={hero.imageUrl} socialImageAlt={hero.imageAlt}>
<nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><a href={`/${page.region.slug}/`}>{page.region.name}</a><span>›</span><span>{page.group.label}</span></nav>
<article class="matrix-detail" data-matrix-key={page.key}>
<section class="detail-hero"><div><span class="eyebrow">{page.region.name} · {page.group.buyerIntent}</span><h1>{page.h1}</h1><p>{page.group.intro}</p><div class="actions"><a class="btn primary" href={active.phoneHref}>☎ {active.phone}</a><a class="btn dark" href={active.orderUrl}>꽃이랑 온라인 주문</a></div><div class="facts"><span>실제 상품 가격 확인</span><span>주소별 추가배송비 확인</span><span>가능한 도착시간 확인</span></div></div>
<figure class="detail-product" data-source-code={hero.code}><img src={hero.imageUrl} alt={hero.imageAlt} loading="eager" width="500" height="500"/><figcaption><strong>{hero.name}</strong><span>{hero.price.toLocaleString()}원</span><small>꽃이랑 상품코드 {hero.code} · {hero.priceVerifiedAt} 가격 확인</small></figcaption></figure></section>
<section class="content-card"><h2>{page.region.name}에서 {page.group.label}을 고를 때</h2><p>{page.region.decisionNote}</p><ul>{page.group.selectionTips.map((tip:string)=><li>{tip}</li>)}</ul></section>
<section class="product-section"><h2>{page.group.label} 실제 상품과 가격</h2><div class="product-grid">{products.map((p:any)=><article class="product-card" data-source-code={p.code}><img src={p.imageUrl} alt={p.imageAlt} loading="lazy" width="500" height="500"/><div><h3>{p.name}</h3><strong>{p.price.toLocaleString()}원</strong><p>상품코드 {p.code} · {p.priceVerifiedAt} 원문 가격 확인</p><a href={p.sourceUrl}>꽃이랑 상품 원문 확인 →</a></div></article>)}</div><p class="product-notice">실제 배송 상품은 지역·계절에 따라 꽃 구성과 형태가 일부 달라질 수 있습니다.</p></section>
<section class="content-card"><h2>주문 전에 준비할 정보</h2><ul>{page.group.questions.map((q:string)=><li>{q}</li>)}</ul></section>
<section class="content-card"><h2>{page.region.name} 배송 조건</h2><p>{page.region.deliveryNote}</p><p><a href={page.region.sourceUrl} rel="nofollow">{page.region.name} 공식 지역 정보 확인 →</a></p></section>
<section class="faq"><h2>{page.region.name} {page.group.label} 자주 묻는 질문</h2><div><h3>표시가격만 결제하면 되나요?</h3><p>받는 주소에 따라 추가 배송비가 발생할 수 있습니다. 상품 가격과 배송지 조건을 함께 확인해 최종 금액을 정합니다.</p></div><div><h3>사진과 완전히 같은 꽃이 배송되나요?</h3><p>상품 사진은 실제 판매 상품을 확인하기 위한 자료이며 지역과 계절에 따라 꽃 구성과 형태가 일부 달라질 수 있습니다.</p></div><div><h3>원하는 시간에 도착하나요?</h3><p>희망시간을 알려 주시면 상품 준비와 지역 배송 상황을 확인해 가능한 도착시간을 안내받을 수 있습니다. 확인 전 도착을 보장하지 않습니다.</p></div></section>
<section class="related"><h2>{page.region.name}의 다른 상품 안내</h2><div class="card-grid">{siblingGroups.map((g:any)=><a class="page-card" href={`/${page.region.slug}/${g.slug}/`}><strong>{page.region.name} {g.label}</strong><span>{g.buyerIntent}</span></a>)}</div></section>
<section class="conversion-panel"><div><span class="eyebrow">{active.brand} 주문</span><h2>상품과 수령정보를 정했다면 문의해 주세요</h2><p>전화 {active.phone} · 주소별 추가 배송비와 가능한 도착시간 확인</p></div><div class="actions"><a class="btn light" href={active.phoneHref}>전화주문</a><a class="btn yellow" href={active.orderUrl}>온라인 주문</a></div></section>
</article>
</BaseLayout>
