---
import BaseLayout from '../layouts/BaseLayout.astro';
import instances from '../data/site-instances.json';
import regions from '../data/regions-matrix.json';
import productGroups from '../data/product-groups.json';
import sourceProducts from '../data/product-sources.json';
import config from '../data/site-config.json';
import {selectInstance,enabledRows,productsFor} from '../lib/matrix.mjs';
const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
const enabled=enabledRows(active,regions,productGroups);
---
<BaseLayout title={`${active.siteName} | 지역별 근조·축하·승진난·꽃다발`} description="여러 지역의 근조화환·개업축하화환·승진취임 난·꽃다발을 실제 꽃이랑 상품 원문과 연결해 비교하고 주문 준비를 확인하세요." canonicalPath="/">
<section class="home-hero"><div class="hero-copy"><span class="eyebrow">{active.coverageLabel} · {active.brand}</span><h1>지역과 상품을 함께 골라<br/>꽃배달 주문을 준비하세요</h1><p>근조화환, 개업·축하화환, 승진·취임 난, 꽃다발을 지역별로 확인할 수 있습니다. 정확한 주소에 따른 추가 배송비와 가능한 도착시간은 주문 전에 확인합니다.</p><div class="actions"><a class="btn primary" href={active.phoneHref}>☎ {active.phone} 전화주문</a><a class="btn dark" href={active.orderUrl}>꽃이랑 온라인 주문</a></div></div></section>
<section class="purpose-navigation"><div class="section-title"><span class="eyebrow">지역 선택</span><h2>어느 지역으로 보내시나요?</h2></div><div class="purpose-grid">{enabled.regions.map((region:any)=><a class="page-card purpose-card" href={`/${region.slug}/`}><strong>{region.name}</strong><span>상품별 주문 안내 보기</span></a>)}</div></section>
<section class="purpose-navigation"><div class="section-title"><span class="eyebrow">상품 선택</span><h2>어떤 꽃 상품이 필요한가요?</h2></div><div class="purpose-grid">{enabled.groups.map((group:any)=>{const rows=productsFor(group,sourceProducts);const current=rows.find((p:any)=>p.priceVerifiedAt);return <a class="page-card purpose-card" href={`/products/${group.slug}/`}><strong>{group.label}</strong><span>{current ? `${current.name} ${current.price.toLocaleString()}원부터 확인` : '상품 원문 가격 재확인 중'}</span><em>{group.buyerIntent}</em></a>})}</div></section>
<section class="content-card"><h2>배송비와 상품 구성은 주문 전에 확인합니다</h2><p>꽃이랑은 전국 배송 상품을 운영하지만 받는 주소에 따라 추가 배송비가 발생할 수 있습니다. 실제 배송 상품은 지역·계절에 따라 꽃 구성과 형태가 일부 달라질 수 있으므로 상품 원문과 상담 내용을 함께 확인하세요.</p></section>
</BaseLayout>
