---
import BaseLayout from '../layouts/BaseLayout.astro';
import instances from '../data/site-instances.json';
import regions from '../data/regions-matrix.json';
import productGroups from '../data/product-groups.json';
import sourceProducts from '../data/product-sources.json';
import config from '../data/site-config.json';
import {selectInstance,enabledRows,productsFor} from '../lib/matrix.mjs';
const active=selectInstance(instances,import.meta.env.SITE_INSTANCE || config.defaultInstance);
const enabled=enabledRows(active,regions,productGroups);
const lead=productsFor(enabled.groups[0],sourceProducts)[0];
---
<BaseLayout title={`${active.siteName} | 지역별 근조·축하·승진난·꽃다발`} description="여러 지역의 근조화환·개업축하화환·승진취임 난·꽃다발을 실제 꽃이랑 상품 사진과 가격으로 비교하고 주문 준비를 확인하세요." canonicalPath="/" socialImageUrl={lead.imageUrl} socialImageAlt={lead.imageAlt}>
<section class="home-hero"><div class="hero-copy"><span class="eyebrow">{active.coverageLabel} · {active.brand}</span><h1>지역과 상품을 함께 골라<br/>꽃배달 주문을 준비하세요</h1><p>근조화환, 개업·축하화환, 승진·취임 난, 꽃다발을 여러 지역에서 한 사이트로 확인합니다. 실제 상품 사진과 가격을 비교하고 주소별 추가 배송비와 가능한 도착시간은 주문 전에 확인합니다.</p><div class="actions"><a class="btn primary" href={active.phoneHref}>☎ {active.phone} 전화주문</a><a class="btn dark" href={active.orderUrl}>꽃이랑 온라인 주문</a></div></div>
<div class="hero-products">{enabled.groups.map((group:any)=>{const p=productsFor(group,sourceProducts)[0];return <a class="hero-product" href={`/products/${group.slug}/`}><img src={p.imageUrl} alt={p.imageAlt} loading="eager" width="500" height="500"/><span>{group.label}<strong>{p.price.toLocaleString()}원부터</strong></span></a>})}</div></section>
<section class="purpose-navigation"><div class="section-title"><span class="eyebrow">지역 선택</span><h2>어느 지역으로 보내시나요?</h2></div><div class="purpose-grid">{enabled.regions.map((region:any)=><a class="page-card purpose-card" href={`/${region.slug}/`}><strong>{region.name}</strong><span>{region.decisionNote}</span></a>)}</div></section>
<section class="purpose-navigation"><div class="section-title"><span class="eyebrow">상품 선택</span><h2>어떤 꽃 상품이 필요한가요?</h2></div><div class="purpose-grid">{enabled.groups.map((group:any)=>{const p=productsFor(group,sourceProducts)[0];return <a class="page-card purpose-card" href={`/products/${group.slug}/`}><strong>{group.label}</strong><span>{p.name} {p.price.toLocaleString()}원부터 확인</span><em>{group.buyerIntent}</em></a>})}</div></section>
<section class="content-card"><h2>배송비와 상품 구성은 주문 전에 확인합니다</h2><p>꽃이랑 상품은 받는 주소에 따라 추가 배송비가 발생할 수 있습니다. 실제 배송 상품은 지역·계절에 따라 꽃 구성과 형태가 일부 달라질 수 있으므로 상품 원문과 상담 내용을 함께 확인하세요.</p></section>
</BaseLayout>
