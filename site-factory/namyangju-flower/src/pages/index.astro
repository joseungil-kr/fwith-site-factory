---
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import pages from '../lib/all-pages.mjs';
import products from '../data/products.json';
import {site,serviceGroups as groups} from '../config/site';
import {groupsFor,assertRegionalInput} from '../lib/regional-runtime.mjs';
assertRegionalInput(pages);
const districts:{key:string;name:string}[]=groupsFor(pages);
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['bouquet-happiness','basket-sunshine','funeral-basic','congrats-basic'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={`${site.region} 꽃배달 | 근조·축하화환·꽃선물 ${site.brand}`} description={`${site.region} 꽃배달로 전할 축하와 위로, 고마운 마음을 준비하세요. 꽃다발·꽃바구니·화환의 실제 사진과 기본가격을 비교하고 편하게 상담할 수 있습니다.`} canonicalPath="/" socialProduct={heroProducts[0] || products[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>{site.region} 꽃배달,<br/>전할 마음에 맞게 고르세요</h1><p>축하하고 싶은 날, 고마운 마음을 전할 때, 조용한 위로가 필요한 순간에 꽃을 준비하세요. 실제 상품 사진과 기본가격을 살펴보고 받는 분과 예산에 맞춰 편하게 상담할 수 있습니다.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>전달 일정·최종금액 상담</span></div></div>
 <div class="hero-products" aria-label="꽃다발·꽃바구니·화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원</strong></span></a>)}</div>
</section>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>어떤 마음을 전하고 싶으세요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>상품·주문 준비 보기 →</em></a>)}</div></section>}
{districts.length>0 && <section class="purpose-navigation" data-region-navigation><div class="section-title"><h2>지역별 꽃배달 안내</h2><p>꽃을 전할 지역에서 생일과 감사, 새 출발을 준비하는 이야기를 찾아보세요.</p></div><div class="purpose-grid">{districts.map(district=><a class="page-card purpose-card" href={`/regions/#${district.key}`}><strong>{district.name}</strong><span>지역별 꽃 선물 이야기</span></a>)}</div><a href="/regions/">지역 전체 보기 →</a></section>}
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>꽃다발·꽃바구니·화환을 비교하세요</h2><p>상품 이미지는 실제 판매 구성의 예시이며 지역·계절에 따라 꽃이 달라질 수 있습니다.</p></div><ProductCards products={featured}/></section>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>소중한 날에 어울리는 꽃 선물 이야기</h2></div>{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
</BaseLayout>

