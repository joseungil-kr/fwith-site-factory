---
import {site} from '../config/site';
const {products=[]}=Astro.props;
---
<div class="product-grid">{products.map((p:any)=><article class="product-card" data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="lazy" width="420" height="420"/><div><h3>{p.name}</h3><strong>{p.price.toLocaleString()}원</strong><p>{p.desc}</p><!-- 리본 예시 안내는 상품 목록 아래에 한 번 표시합니다. --><a href={p.orderUrl || site.orderUrl}>상품 확인·주문 →</a></div></article>)}</div>
<p class="product-notice">상품 사진과 리본문구는 예시입니다. {site.productVariationNotice} {site.deliveryNotice}</p>
