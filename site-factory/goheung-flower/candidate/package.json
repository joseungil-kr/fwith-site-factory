{
  "name": "flower-direct-static-goheung-private",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/bin/astro.mjs check",
    "build": "node scripts/verify_inputs.mjs && ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/bin/astro.mjs check && ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/bin/astro.mjs build && python3 scripts/qa_goheung.py",
    "test": "node --test tests/*.test.mjs && python3 scripts/test_goheung.py",
    "qa": "python3 scripts/qa_goheung.py",
    "browser": "python3 scripts/browser_check.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0"
  }
}
