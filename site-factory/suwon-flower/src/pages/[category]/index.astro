---
import RegionalHub from '../../components/RegionalHub.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PurchaseBanner from '../../components/PurchaseBanner.astro';
import pages from '../../lib/all-pages.mjs';
import products from '../../data/products.json';
import ProductCards from '../../components/ProductCards.astro';
import {site,groups} from '../../config/site';
import {hubGuides,hubProducts} from '../../lib/hubs.mjs';
import editorial from '../../data/editorial-assets.json';
export function getStaticPaths(){return groups.map(g=>({params:{category:g.cat},props:{group:g}}));}
const {group}=Astro.props; const items=(pages as any[]).filter(p=>p.category===group.cat);
const guide=hubGuides[group.cat] || {intro:'',decision:[],heading:'',cta:''}; const selected=hubProducts(group.cat,products,group.cat==='order'?4:3);
const hero=selected[0];
const illustration=group.cat==='business'?editorial.openingWreath:null;
const addressPage=(pages as any[]).find(p=>p.visualIntent==='order_address');
---
{group.cat==='regions' && items.every(p=>p.publicationMode!=='manual-user-request') ? <RegionalHub/> : <BaseLayout title={`${site.region} ${group.label} 꽃배달 | ${site.brand}`} description={guide.intro} canonicalPath={group.url} socialImage={hero} orderUrl={hero?.orderUrl || site.orderUrl}>
<nav class="breadcrumb" aria-label="현재 위치"><a href="/">{site.region} 꽃배달</a><span>›</span><span>{group.label}</span></nav>
<section class="category-hero hub-hero"><div><span class="eyebrow">{site.brand} {site.region}</span><h1>{site.region} {group.label} 꽃배달</h1><p>{guide.intro}</p><ul class="decision-list">{guide.decision.map((tip:string)=><li>{tip}</li>)}</ul><div class="actions"><a class="btn primary" href={site.phoneHref}>전화 상담·주문</a><a class="btn dark" href={hero?.orderUrl || site.orderUrl}>{guide.cta}</a></div></div>{illustration ? <figure class="hub-product editorial-hero" data-asset-type={illustration.assetType}><img src={illustration.img} alt={illustration.alt} width="1000" height="1000" loading="eager"/><figcaption>{illustration.caption}</figcaption></figure> : hero && <a class="hub-product" href={hero.orderUrl} data-product-family={hero.family} data-product-key={hero.key}><img src={hero.img} alt={hero.name} width="420" height="420" loading="eager"/><strong>{hero.name} · {hero.price.toLocaleString()}원</strong><span>상품 확인·주문 →</span></a>}</section>
{group.cat==='gift' && <aside class="caution"><strong>회복을 응원하는 꽃 선물</strong><p>병실 선물은 해당 병동의 꽃 수령 안내에 맞춰 준비해 주세요. 퇴원 뒤 편안한 집에서 감상할 꽃을 고르셔도 좋습니다.</p></aside>}
<section class="product-section"><h2>{guide.heading}</h2><ProductCards products={selected}/></section>
<PurchaseBanner pageRole="hub" heading={`${group.label}에 전할 마음을 상담하세요`}/>
<section class="section-title"><h2>{group.label} 장소·상황별 주문 안내</h2><p>선물할 순간과 받는 분을 떠올리며 자세한 이야기를 살펴보세요.</p></section>
<section class="card-grid big">{items.map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span><em>자세히 보기 →</em></a>)}</section>
{addressPage && <aside class="journey-link"><span>주문 상담을 이어가려면</span><a href={addressPage.url}>주소·수령자 작성 안내 →</a></aside>}
</BaseLayout>}
