    "src/layouts/BaseLayout.astro": {
      "sha256": "251e59314152aa00ca07be83251a5573b9cbc0674b788d39edacb4581095e5d5",
      "text": "---\nimport '../styles/global.css';\nimport {site,groups,regionalMenuEligible} from '../config/site';\nimport buildRevision from '../data/build-revision.json';\nimport {socialImageFor} from '../lib/social-image.mjs';\nconst {title,description,canonicalPath='/',noindex=false,socialImage=null,orderUrl=site.orderUrl}=Astro.props;\nconst canonical=new URL(canonicalPath,site.domain).toString();\nconst indexable=site.indexable && !noindex;\nconst revision=buildRevision.revision || 'local';\nconst social=Astro.props.ogImage ? {path:Astro.props.ogImage,alt:Astro.props.ogImageAlt,width:Astro.props.ogImageWidth,height:Astro.props.ogImageHeight,type:Astro.props.ogImageType} : (noindex ? null : socialImageFor(socialImage));\nconst socialUrl=social ? new URL(social.path,site.domain).toString() : null;\n---\n<!doctype html><html lang=\"ko\"><head>\n<meta charset=\"UTF-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\n<title>{title}</title><meta name=\"description\" content={description}/>\n<meta name=\"robots\" content={!site.indexable ? 'noindex,nofollow,noarchive' : (Astro.props.robotsOverride || (indexable?'index,follow':'noindex,nofollow,noarchive'))}/>\n{indexable && <meta name=\"naver-site-verification\" content={site.naverVerification}/>}\n<meta name=\"site-factory-revision\" content={revision}/><link rel=\"canonical\" href={canonical}/>\n<meta property=\"og:type\" content=\"website\"/><meta property=\"og:title\" content={title}/><meta property=\"og:description\" content={description}/><meta property=\"og:url\" content={canonical}/><meta property=\"og:locale\" content=\"ko_KR\"/>\n{social && <><meta property=\"og:image\" content={socialUrl}/><meta property=\"og:image:secure_url\" content={socialUrl}/><meta property=\"og:image:alt\" content={social.alt}/><meta property=\"og:image:type\" content={social.type}/><meta property=\"og:image:width\" content={social.width}/><meta property=\"og:image:height\" content={social.height}/><meta name=\"twitter:image\" content={socialUrl}/><meta name=\"twitter:image:alt\" content={social.alt}/></>}\n<meta name=\"twitter:card\" content={social?'summary_large_image':'summary'}/><meta name=\"twitter:title\" content={title}/><meta name=\"twitter:description\" content={description}/>\n<meta name=\"theme-color\" content=\"#3a214f\"/>\n<script type=\"application/ld+json\" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Florist',name:site.brand,url:site.domain,telephone:site.phone,areaServed:site.region}).replace(/</g, String.fromCharCode(92) + 'u003c')}></script>\n</head><body>\n<a class=\"skip-link\" href=\"#main-content\">본문 바로가기</a>\n<header class=\"site-header\"><div class=\"header-inner\"><a class=\"brand\" href=\"/\"><span class=\"brand-icon\">✿</span><span><b>{site.brand}</b><small>{site.region} 꽃배달</small></span></a>\n<nav aria-label=\"주요 메뉴\">{groups.filter(g=>g.cat!=='regions'||regionalMenuEligible).map(g=><a href={g.url}>{g.label}</a>)}</nav><a class=\"phone\" href={site.phoneHref}>☎ {site.phone}</a></div></header>\n<main id=\"main-content\"><slot/></main>\n<footer><div><strong>{site.brand} {site.region}</strong><span>{site.orderHours}</span><a href={site.phoneHref}>{site.phone}</a><a href={orderUrl}>온라인 주문</a><small>{site.deliveryNotice}</small></div></footer>\n<div class=\"mobile-bar\"><a href={site.phoneHref}>전화주문</a><a href={orderUrl}>온라인 주문</a></div>\n</body></html>\n"
    },
    "src/pages/404.astro": {
      "sha256": "f02c6e89fda31f13cc07517422e9a2d2d492cb30c22bc24a0faf1ad3569cd086",
      "text": "--- import BaseLayout from '../layouts/BaseLayout.astro'; ---<BaseLayout title=\"페이지를 찾을 수 없습니다 | 꽃이랑 수원\" description=\"요청한 페이지를 찾을 수 없습니다.\" noindex={true}><section class=\"not-found\"><h1>페이지를 찾을 수 없습니다</h1><p>수원 꽃배달 메인에서 필요한 정보를 다시 찾아보세요.</p><a class=\"btn primary\" href=\"/\">홈으로 이동</a></section></BaseLayout>"
    }
