---
import InlineCopy from './InlineCopy.astro';
const {blocks=[],faq=false,opening=false}=Astro.props;
---
{blocks.map((b:any,i:number)=>b.kind==='h3'?<h3 data-reviewed-block data-faq-question={faq||undefined}>{b.text}</h3>:b.kind==='paragraph'?<p data-reviewed-block data-first-answer={opening&&i===0||undefined} data-faq-answer={faq&&blocks[i-1]?.kind==='h3'||undefined}><InlineCopy text={b.text}/></p>:b.kind==='action'?<div class="actions"><a class="btn primary" data-reviewed-block data-required-cta href={b.href}>{b.label}</a></div>:b.kind==='list'?<ul>{b.items.map((text:string)=><li data-reviewed-block><InlineCopy text={text}/></li>)}</ul>:b.kind==='products'?<div class="product-grid">{b.cards.map((card:any)=><article class="product-card" data-product-sku={card.heading.split(' ').at(-1)}><h3 data-reviewed-block>{card.heading}</h3>{card.blocks.map((cb:any)=>cb.kind==='image'?<img data-reviewed-image src={cb.src} alt={cb.alt} width="500" height="500" loading="lazy" decoding="async"/>:cb.kind==='paragraph'?<p class="product-price" data-reviewed-block>{cb.text}</p>:<a data-reviewed-block data-required-cta data-order-product-sku={card.heading.split(' ').at(-1)} href={cb.href}>{cb.label}</a>)}</article>)}</div>:null)}
