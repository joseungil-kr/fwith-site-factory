---
import {regionalPages} from '../lib/regional-runtime.mjs';
import { getVisibleArticles as getCollection, isArticleVisible } from '../lib/all-articles';
import BaseLayout from '../layouts/BaseLayout.astro';
import OrderCTA from '../components/OrderCTA.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import business from '../data/business-truth.json';
import { siteConfig } from '../config/site';
import architecture from '../lib/all-architecture.mjs';

const activePageKeys = new Set((architecture.pages || []).filter((page) => page.sitemapIndexable !== false && page.status !== 'merged').map((page) => page.pageKey));

const articles = (await getCollection(
  'articles',
  ({ data }) => isArticleVisible(data) && activePageKeys.has(data.pageKey)
)).sort((a, b) => b.data.pageKey.localeCompare(a.data.pageKey, 'ko'));

const recent = articles.slice(0, 6);
const hrefFor = (article: (typeof articles)[number]) =>
  article.data.routeType === 'top_level' ? `/${article.data.slug}/` : `/${article.data.category}/${article.data.slug}/`;

const categoryLabel: Record<string, string> = {
  guide: '꽃 선택', funeral: '장례식장', places: '장소별', occasions: '상황별',
  'flower-knowledge': '꽃 관리', 'order-help': '주문 도움',
};
const categoryCounts = articles
  .filter((article) => article.data.routeType === 'category')
  .reduce<Record<string, number>>((acc, article) => {
    acc[article.data.category] = (acc[article.data.category] ?? 0) + 1;
    return acc;
  }, {});
const trust = [
  ['truck', '전국 배송 가능', '지역별 추가배송비 발생 가능'],
  ['clock', '신속한 주문 접수', '전화 08:00~23:00'],
  ['shield', '상황에 맞는 꽃선물', '상품과 전달 일정 상담'],
  ['headset', '전화 상담', '1844-0644'],
];
const situations = [
  { tag: '이용 가이드', title: `${siteConfig.region} 꽃배달 이용 가이드`, body: '축하와 감사, 위로를 전할 꽃을 선물할 상황에 맞춰 살펴보세요.', href: `/${siteConfig.primaryLandingSlug}/`, visible: true },
  { tag: '장례', title: '장례식장 근조화환', body: '고인을 추모하고 유가족께 위로를 전할 근조화환을 안내합니다.', href: '/funeral/', visible: (categoryCounts.funeral ?? 0) >= 3 },
  { tag: '개업·이전', title: '개업·이전 축하꽃', body: '새 가게와 사업장의 시작을 꽃으로 함께 응원해 보세요.', href: '/occasions/', visible: (categoryCounts.occasions ?? 0) >= 3 },
  { tag: '장소별', title: '역·병원·대학·행사장', body: '졸업과 공연, 기념일의 약속에 어울릴 꽃선물을 찾아보세요.', href: '/places/', visible: (categoryCounts.places ?? 0) >= 3 },
  { tag: '주문 도움', title: '꽃과 함께 전할 인사', body: '기쁜 소식과 고마운 마음을 담을 인사와 주문 안내를 살펴보세요.', href: '/order-help/', visible: (categoryCounts['order-help'] ?? 0) >= 3 },
  { tag: '꽃 관리', title: '꽃다발·꽃바구니 관리', body: '선물받은 꽃을 즐기는 방법과 형태별 특징을 살펴보세요.', href: '/flower-knowledge/', visible: (categoryCounts['flower-knowledge'] ?? 0) >= 3 },
].filter((item) => item.visible);
---
<BaseLayout>
  <section class="hero hero-commerce">
    <div class="container hero-commerce-grid">
      <div class="hero-copy">
        <span class="hero-badge">{siteConfig.region} 전 지역 꽃배달</span>
        <h1>{siteConfig.region} <em>꽃배달</em></h1>
        <p class="hero-lead">소중한 마음을 꽃으로 전하세요.</p>
        <p class="hero-sub">기쁜 날의 축하부터 조용한 위로까지.<br />받는 분을 떠올리며 마음에 맞는 꽃을 골라 보세요.</p>
        <div class="hero-actions hero-order-actions">
          <a class="hero-phone" href={business.phoneHref}><span>☎</span><strong>전화주문 {business.phone}</strong><small>{business.phoneOrderHours}</small></a>
          <a class="hero-online" href={business.onlineOrderUrl} rel="noopener"><span>▣</span><strong>온라인 주문</strong><small>24시간 주문 가능</small></a>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="주문 및 배송 안내">
    <div class="container trust-grid">
      {trust.map(([icon, title, desc]) => (
        <div class="trust-item"><span class:list={['trust-icon', `trust-icon-${icon}`]} aria-hidden="true"></span><div><strong>{title}</strong><span>{desc}</span></div></div>
      ))}
    </div>
  </section>

  <section class="section product-section"><div class="container"><ProductShowcase showHeading={false} /></div></section>

  <div class="container" data-purchase-banner="middle" data-page-role="home">
    <OrderCTA heading={`${siteConfig.region}에 전할 마음, 꽃이랑에 이야기해 주세요`} />
  </div>

  {situations.length > 0 && (
    <section class="section guide-section">
      <div class="container">
        <div class="section-head simple-head"><div><h2>{siteConfig.region} 꽃배달 이용 안내</h2><p class="section-intro">소중한 분께 꽃을 전할 장면을 떠올리며 읽어 보세요.</p></div></div>
        <div class="guide-tile-grid">
          {situations.map((item, index) => (
            <a class:list={['guide-tile', `guide-tile-${index + 1}`]} href={item.href}><span>{item.tag}</span><h3>{item.title}</h3><p>{item.body}</p><b>자세히 보기 ›</b></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="info-band">
    <div class="container info-band-grid">
      <div><strong>주문 가능 시간</strong><span>전화주문 08:00~23:00 · 온라인 24시간</span></div>
      <div><strong>배송 안내</strong><span>전국 배송 가능 · 지역별 추가배송비 발생 가능</span></div>
      <div><strong>상품 안내</strong><span>지역·계절에 따라 꽃 구성과 형태가 일부 달라질 수 있습니다.</span></div>
      <div><strong>{siteConfig.region} 꽃배달 정보</strong><span>기념일·졸업·개업·결혼·조문의 꽃선물을 살펴보세요.</span></div>
    </div>
  </section>

  <section class="section recent-section">
    <div class="container">
      <div class="section-head simple-head"><div><h2>꽃선물 이야기</h2><p class="section-intro">{siteConfig.region}에서 꽃을 전할 상황별 이야기를 만나 보세요.</p></div></div>
      <div class="grid grid-3">
        {recent.map((article) => (
          <a class="card recent-card" href={hrefFor(article)}>
            <div><span class="tag">{article.data.region} · {categoryLabel[article.data.category] ?? '가이드'}</span><h3>{article.data.title}</h3><p>{article.data.cardSummary || article.data.description}</p></div>
            <span class="more">가이드 읽기 ›</span>
          </a>
        ))}
      </div>
    </div>
  </section>
{regionalPages.length>0 && <section class="section"><div class="container"><a href="/regions/">{siteConfig.region} 지역별 꽃배달 안내 →</a></div></section>}
</BaseLayout>
