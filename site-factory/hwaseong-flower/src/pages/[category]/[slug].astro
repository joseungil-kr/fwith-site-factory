---
import { getArticleCollection } from "../../lib/manual-content";
import { getCollection, render, type CollectionEntry } from 'astro:content';
import {assertRegionalInput} from '../../lib/regional-runtime.mjs';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

type Article = CollectionEntry<'articles'> | CollectionEntry<'manualArticles'>;

export async function getStaticPaths() {
  const articles = await getArticleCollection(
    'articles',
    ({ data }) =>
      (data.draftStatus === 'approved' || data.draftStatus === 'published' || ('publicationMode' in data && data.publicationMode === 'manual-user-request')) &&
      data.routeType === 'category'
  );
  assertRegionalInput(articles.map(article=>article.data));
  return articles.map((article) => ({
    params: {
      category: article.data.category,
      slug: article.data.slug,
    },
    props: { article },
  }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
---
<ArticleLayout
  orderPanel={'orderPanel' in article.data ? article.data.orderPanel : undefined}
  pageKey={article.data.pageKey}
  title={article.data.title}
  description={article.data.description}
  h1={article.data.h1}
  firstAnswer={article.data.firstAnswer}
  queryClass={article.data.queryClass}
  visualIntent={article.data.visualIntent}
  assetSlot={article.data.assetSlot}
  category={article.data.category}
  structureType={article.data.structureType}
  pageType={article.data.pageType}
  contentRole={article.data.contentRole}
  localizationPolicy={article.data.localizationPolicy}
  region={article.data.region}
  snapshotId={'snapshotId' in article.data ? article.data.snapshotId : undefined}
  manualPublicationId={'manualPublicationId' in article.data ? article.data.manualPublicationId : undefined}
  slug={article.data.slug}
  routeType={article.data.routeType}
  sourceUrls={article.data.sourceUrls}
  sources={article.data.sources}
  relatedPageKeys={article.data.relatedPageKeys}
  verifiedAt={article.data.verifiedAt}
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  ogImage={article.data.ogImage}
  ogImageAlt={article.data.ogImageAlt}
>
  <Content />
</ArticleLayout>

