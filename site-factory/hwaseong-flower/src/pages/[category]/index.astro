---
import { getArticleCollection } from "../../lib/manual-content";
import { getCollection } from 'astro:content';
import RegionalHub from '../../components/RegionalHub.astro';
import {regionalPages} from '../../lib/regional-runtime.mjs';
import HubIndex from '../../components/HubIndex.astro';
import architecture from '../../data/architecture.json';
import { siteConfig } from '../../config/site';

const categoryMeta = {
  guide: {
    eyebrow: '꽃 선택',
    title: `${siteConfig.region} 꽃 선택·이용 가이드`,
    intro: '손에 건넬 꽃다발부터 행사장의 화환까지, 전하고 싶은 장면에 맞춰 골라 보세요.',
    description: `${siteConfig.region} 꽃배달을 준비할 때 필요한 꽃 선택과 이용 기준을 정리합니다.`,
  },
  funeral: {
    eyebrow: '장례식장',
    title: `${siteConfig.region} 장례식장 근조화환 안내`,
    intro: '고인을 기억하는 마음과 유가족을 향한 위로를 담아 조의의 꽃을 준비해 보세요.',
    description: `${siteConfig.region} 장례식장에 전할 근조화환 상품과 공동 주문, 조문 일정에 맞는 상담을 안내합니다.`,
  },
  places: {
    eyebrow: '장소별',
    title: `${siteConfig.region} 장소별 꽃배달 안내`,
    intro: '졸업식과 공연, 반가운 만남에 어울리는 꽃 선물을 장소별로 살펴보세요.',
    description: `${siteConfig.region}의 대학, 병원, 행사장 등에서 전할 축하와 응원의 꽃을 소개합니다.`,
  },
  occasions: {
    eyebrow: '상황별',
    title: `${siteConfig.region} 상황별 축하꽃·꽃배달 안내`,
    intro: '새로운 도전을 응원하고 소중한 성취를 축하하는 마음에 어울리는 꽃을 찾아보세요.',
    description: `${siteConfig.region} 개업, 이전, 졸업, 행사 등 상황별 꽃배달 선택 기준을 안내합니다.`,
  },
  'flower-knowledge': {
    eyebrow: '꽃 관리',
    title: '꽃 선택과 관리 가이드',
    intro: '꽃다발·꽃바구니·화환의 형태 차이와 이동·보관·관리 기준을 정리합니다.',
    description: '꽃 형태별 선택과 이동, 보관, 계절별 관리에 필요한 실용 정보를 안내합니다.',
  },
  'order-help': {
    eyebrow: '주문 도움',
    title: `${siteConfig.region} 꽃배달 주문 준비 가이드`,
    intro: '상품 선택과 예산, 함께 전할 인사까지. 꽃 주문을 편안하게 준비해 보세요.',
    description: `${siteConfig.region} 꽃배달 상품과 예산을 고르고 축하와 위로의 인사를 준비하도록 도와드립니다.`,
  },
} as const;

type Category = keyof typeof categoryMeta | 'regions';

export async function getStaticPaths() {
  const activePageKeys = new Set(
    (architecture.pages || [])
      .filter((page) => page.sitemapIndexable !== false && page.status !== 'merged')
      .map((page) => page.pageKey)
  );
  const articles = await getArticleCollection(
    'articles',
    ({ data }) =>
      (data.draftStatus === 'approved' || data.draftStatus === 'published' || ('publicationMode' in data && data.publicationMode === 'manual-user-request')) &&
      data.routeType === 'category' &&
      activePageKeys.has(data.pageKey)
  );
  const allowedCategories = new Set(['guide', 'funeral', 'places', 'occasions', 'flower-knowledge', 'order-help']);
  const categories = [...new Set(articles.map((article) => article.data.category))]
    .filter((category) => allowedCategories.has(category)) as Category[];
  return [...categories, ...(regionalPages.length ? ['regions'] : [])].map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props as { category: Category };
const meta = category==='regions' ? null : categoryMeta[category];
---
{category==='regions' ? <RegionalHub/> : <HubIndex
  category={category}
  eyebrow={meta!.eyebrow}
  title={meta!.title}
  intro={meta!.intro}
  description={meta!.description}
/>}
