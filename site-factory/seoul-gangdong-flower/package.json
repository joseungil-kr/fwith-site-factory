{
  "name": "flower-direct-static-gwanak",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate_gangdong_runtime.mjs",
    "typecheck": "astro check",
    "build": "node scripts/verify_reuse_provenance.mjs && node scripts/gangdong_release.mjs && node scripts/generate_gangdong_runtime.mjs --check && astro check && astro build && node scripts/write_gangdong_release_files.mjs && python3 scripts/qa_gangdong.py",
    "test": "node --test tests/*.test.mjs && python3 scripts/test_gangdong.py",
    "qa": "node scripts/generate_gangdong_runtime.mjs --check && python3 scripts/qa_gangdong.py",
    "test:production": "npm test && python3 scripts/test_gangdong_release_output.py",
    "verify:provenance": "node scripts/verify_reuse_provenance.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.0.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.9.0"
  }
}
