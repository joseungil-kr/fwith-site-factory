---
interface Props { variant: 'message' | 'budget' | 'consultation'; }
const {variant}=Astro.props;
import approvedCopy from '../data/gwanak-copy.json';
const banners=approvedCopy.common.banners;
const banner=banners[variant];
if(!banner) throw new Error('Unknown shared flower banner');
---
<figure class="shared-flower-banner" data-shared-flower-banner={variant}>
  <img src={`/images/shared-banners/${banner.file}`} alt={banner.alt} width="1774" height="887" loading="lazy" decoding="async"/>
  <figcaption>{banners.caption}</figcaption>
</figure>
<style>
.shared-flower-banner{margin:2rem auto;width:100%;max-width:60rem;overflow:hidden}
.shared-flower-banner img{display:block;width:100%;height:auto;aspect-ratio:2/1;border-radius:1rem}
.shared-flower-banner figcaption{padding:.5rem .125rem 0;font-size:.75rem;line-height:1.5;color:#655568}
@media(max-width:600px){.shared-flower-banner{margin:1.5rem auto}.shared-flower-banner img{border-radius:.625rem}}
</style>
