---
import {displayMarkdownBlocks} from '../lib/content.mjs';
import {reviewedHeadingAnchors} from '../lib/yeongdeungpo-heading-anchors.mjs';
import InlineText from './InlineText.astro';
const blocks=displayMarkdownBlocks(Astro.props.content || '', Astro.props.firstAnswer);
const anchors=reviewedHeadingAnchors(blocks,Astro.props.facilityAnchors);
---
<div class="content-card markdown-content">{blocks.map(block => block.type === 'h2' ? <h2 id={anchors.get(block.text)}><InlineText text={block.text}/></h2> : block.type === 'h3' ? <h3 id={anchors.get(block.text)}><InlineText text={block.text}/></h3> : block.type === 'li' ? <ul><li><InlineText text={block.text}/></li></ul> : <p><InlineText text={block.text}/></p>)}</div>
