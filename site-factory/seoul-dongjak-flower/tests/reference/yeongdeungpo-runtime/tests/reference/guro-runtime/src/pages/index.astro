---
import SharedFlowerBanner from '../components/SharedFlowerBanner.astro';
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import pages from '../data/pages.json';
import products from '../data/products.json';
import {site,serviceGroups as groups} from '../config/site';
import {groupsFor,assertRegionalInput} from '../lib/regional-runtime.mjs';
assertRegionalInput(pages);
const districts:{key:string;name:string}[]=groupsFor(pages);
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['funeral-basic','funeral-premium','congrats-basic','congrats-premium'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={`${site.region} 화환 주문 | ${site.brand}`} description={"구로구 장례식장과 예식장, 사무실로 전할 마음을 꽃이랑과 함께 준비하세요. 실제 화환 사진·기본가격, 리본 문구와 장소별 주문 상담을 안내합니다."} canonicalPath="/" socialProduct={heroProducts[0] || products[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>{site.region} 화환 주문</h1><p>조문의 위로, 결혼의 기쁨, 회사의 새로운 출발. 구로구에 전할 마음에 어울리는 화환을 실제 상품 사진과 예산으로 살펴보고, 꽃이랑에서 리본 문구와 일정을 함께 상담해 보세요.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>상품·예산 상담</span></div></div>
 <div class="hero-products" aria-label="근조·축하화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>기본가격 {p.price.toLocaleString()}원</strong></span></a>)}</div>
</section>
<SharedFlowerBanner variant="message"/>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>상품·주문 준비 보기 →</em></a>)}</div></section>}
{districts.length>0 && <section class="purpose-navigation" data-region-navigation><div class="section-title"><h2>지역별 꽃배달 안내</h2><p>보내실 장소에 맞는 상품과 주문 안내를 모았습니다.</p></div><div class="purpose-grid">{districts.map(district=><a class="page-card purpose-card" href={`/regions/#${district.key}`}><strong>{district.name}</strong><span>받는 장소에 맞는 상품·주문 안내</span></a>)}</div><a href="/regions/">보낼 장소의 주문 안내 보기 →</a></section>}
<SharedFlowerBanner variant="budget"/>
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>예산에 맞는 근조·축하화환</h2><p>사진과 기본가격으로 상품을 비교하실 수 있습니다. 처음 주문하시는 분도 편하게 문의해 주세요. 받는 장소와 예산에 맞춰 선택을 도와드립니다.</p></div><ProductCards products={featured}/></section>
<SharedFlowerBanner variant="consultation"/>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>보내실 장소에 맞는 주문 안내</h2></div>{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
</BaseLayout>
