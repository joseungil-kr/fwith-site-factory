---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import InlineOrderBanner from '../../components/InlineOrderBanner.astro';
import ProductCards from '../../components/ProductCards.astro';
import InlineText from '../../components/InlineText.astro';
import pages from '../../lib/all-pages.mjs';
import products from '../../data/products.json';
import {site,groups} from '../../config/site';
import {selectProducts,productHeading,productFamilies} from '../../lib/catalog.mjs';
import {nextSteps,relatedReading} from '../../lib/journey.mjs';
import editorial from '../../data/editorial-assets.json';
import coverage from '../../data/region-coverage.json';
import {regionUnit} from '../../lib/regions.mjs';
export function getStaticPaths(){return (pages as any[]).map(p=>({params:{category:p.category,slug:p.slug},props:{page:p}}));}
const {page}=Astro.props;
const unit=regionUnit(page,coverage);
const district=unit && coverage.districts.find(district=>district.key===unit.districtKey);
const journey=nextSteps(page,pages);
const related=relatedReading(page,pages);
const productSet=selectProducts(page,products,productFamilies(page).length>3?4:3); const hero=productSet[0];
const illustration=page.pageType==='business-opening' || (page.visualIntent==='event_wreath' && !page.manualReleaseId) ? (editorial as {openingWreath:any}).openingWreath : null;
const category=groups.find(g=>g.cat===page.category);
const snapshotId=page.snapshotId;
const pricePage=journey.find((p:any)=>p.pageType==='price-guide');
const addressPage=journey.find((p:any)=>p.visualIntent==='order_address');
---
<BaseLayout title={page.title} description={page.description} canonicalPath={page.url} orderUrl={site.orderUrl} socialProduct={hero || products.find(p=>p.key==='bouquet-happiness')}>
<article data-manual-release-id={page.manualReleaseId} data-snapshot-id={snapshotId} data-page-key={page.pageKey} data-page-type={page.pageType}>
<nav class="breadcrumb" aria-label="현재 위치"><a href="/">{site.region} 꽃배달</a><span>›</span><a href={category?.url || '/'}>{category?.label || '꽃배달'}</a><span>›</span>{district && <><a href={`/regions/#${district.key}`}>{district.name}</a><span>›</span></>}<span>{page.primaryKeyword}</span></nav>
<section class="detail-hero"><div><span class="eyebrow">{site.brand} {site.region}</span><h1>{page.h1}</h1><p>{page.firstAnswer}</p><div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone}</a><a class="btn dark" href={site.orderUrl}>상품 확인·주문</a></div><div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>상품·전달 일정 상담</span></div></div>
{illustration ? <figure class="detail-product editorial-hero" data-asset-type={illustration.assetType}><img src={illustration.img} alt={illustration.alt} loading="eager" width="1000" height="1000"/><figcaption>{illustration.caption}</figcaption></figure> : hero ? <div class="detail-product" data-product-family={hero.family} data-product-key={hero.key}><img src={hero.img} alt={hero.name} loading="eager" width="540" height="540"/><strong>{hero.name}</strong><span>{hero.price.toLocaleString()}원</span><small>꽃이랑 공식 상품 이미지 · 지역·계절에 따라 구성이 달라질 수 있습니다</small>{hero.family==='congrats' && <small>사진 속 리본은 예시이며, 전하고 싶은 인사로 상담하실 수 있습니다</small>}</div> : <aside class="detail-product"><h2>목적에 맞는 상품을 상담하세요</h2><p>받는 분과 전하고 싶은 마음을 이야기하며 선물할 꽃을 함께 골라 보세요.</p><a class="btn primary" href={site.phoneHref}>전화 상담</a></aside>}
</section>
{page.pageType==='hospital-visit' && <aside class="caution"><strong>병문안 꽃선물 안내</strong><p>생화 반입은 병원·병동에 따라 제한될 수 있습니다. 병동에서 수령할 수 있는 경우에 꽃선물을 상담해 주세요.</p></aside>}
{page.contentMarkdown ? <MarkdownContent content={page.contentMarkdown} showOrderBanner={true}/> : page.sections.slice(0,3).map((s:any)=><section class="content-card"><h2>{s[0]}</h2><p><InlineText text={s[1]}/></p></section>)}
{!page.contentMarkdown && <InlineOrderBanner/>}
{pricePage && pricePage.pageKey!==page.pageKey && <aside class="journey-link"><span>예산을 먼저 정하고 싶다면</span><a href={pricePage.url}>{pricePage.primaryKeyword} 확인 →</a></aside>}
{productSet.length>0 && <section class="product-section compact"><h2>{productHeading(page)}</h2><ProductCards products={productSet}/></section>}
{!page.contentMarkdown && page.sections.slice(3).map((s:any)=><section class="content-card"><h2>{s[0]}</h2><p><InlineText text={s[1]}/></p></section>)}
{addressPage && <aside class="journey-link"><span>꽃을 고른 뒤 주문을 상담하고 싶다면</span><a href={addressPage.url}>{addressPage.primaryKeyword} 확인 →</a></aside>}
{page.source?.url && <section class="source-card"><h2>{page.source.name || page.entity+' 관련 공식정보'}</h2><p>{page.source.url.startsWith('https://fwith.co.kr') ? '꽃이랑의 상품 사진과 주문 안내입니다.' : '본문에서 참고한 장소와 시설의 안내입니다.'}</p><a href={page.source.url} rel="nofollow">공식정보 확인 →</a><small>확인일 {page.source.verifiedAt}</small></section>}
{!page.contentMarkdown && page.faq?.length>0 && <section class="faq"><h2>{page.primaryKeyword} 자주 묻는 질문</h2>{page.faq.map((f:any)=><div><h3>{f[0]}</h3><p>{f[1]}</p></div>)}</section>}
{journey.length>0 && <section class="related" data-journey="next-step"><h2>꽃선물과 주문 이야기</h2><div class="card-grid journey-grid">{journey.map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></section>}
{related.length>0 && <section class="related" data-journey="related-reading"><h2>함께 읽을 장소·상황 안내</h2><div class="card-grid journey-grid">{related.map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></section>}
<section class="conversion-panel"><div><span class="eyebrow">{site.brand} 주문</span><h2>전하고 싶은 마음을 편하게 말씀하세요</h2><p>전화 {site.phone} · {site.phoneOrderHours} / 온라인 {site.onlineOrderHours} 접수</p></div><div class="actions"><a class="btn light" href={site.phoneHref}>전화주문</a><a class="btn yellow" href={site.orderUrl}>상품 확인·주문</a></div></section>
</article></BaseLayout>
