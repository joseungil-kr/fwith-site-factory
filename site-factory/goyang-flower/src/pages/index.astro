---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import pages from '../lib/all-pages.mjs';
import products from '../data/products.json';
import {site,serviceGroups as groups} from '../config/site';
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
import coverage from '../data/region-coverage.json';
import {regionGroups} from '../lib/regions.mjs';
const districts:{key:string;name:string}[]=regionGroups(pages,coverage);
const featured=homeProducts(products);
const heroProducts=['bouquet-happiness','basket-sunshine','funeral-basic','congrats-basic'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={`${site.region} 꽃배달 | 근조·축하화환·꽃선물 ${site.brand}`} description={`${site.region}의 축하와 감사, 위로에 마음을 전하는 꽃이랑. 꽃다발·꽃바구니·화환 사진과 가격을 비교하고 편하게 주문 상담하세요.`} canonicalPath="/" socialProduct={heroProducts[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>{site.region} 꽃배달,<br/>전할 마음에 맞게 고르세요</h1><p>한국항공대에서 졸업을 맞은 가족에게, 어울림누리에서 무대를 마친 친구에게 꽃을 전해 보세요. 킨텍스 그래머시의 예식과 장항동 가게의 새 출발에도 축하를 더하실 수 있습니다. 고양에서 만날 기쁜 순간에 맞춰 꽃과 예산을 함께 골라 보세요.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>상품·전달 일정 상담</span></div></div>
 <div class="hero-products" aria-label="꽃다발·꽃바구니·화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={site.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원</strong></span></a>)}</div>
</section>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>꽃선물 살펴보기 →</em></a>)}</div></section>}
{districts.length>0 && <section class="purpose-navigation" data-region-navigation><div class="section-title"><h2>지역별 꽃배달 안내</h2><p>꽃을 받을 지역의 선물 이야기를 만나 보세요.</p></div><div class="purpose-grid">{districts.map(district=><a class="page-card purpose-card" href={`/regions/#${district.key}`}><strong>{district.name}</strong><span>지역별 꽃선물 이야기</span></a>)}</div><a href="/regions/">지역 전체 보기 →</a></section>}
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>꽃다발·꽃바구니·화환을 비교하세요</h2><p>상품 이미지는 실제 판매 구성의 예시이며 지역·계절에 따라 꽃이 달라질 수 있습니다.</p></div><ProductCards products={featured}/></section>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>꽃을 전하고 싶은 날의 이야기를 만나 보세요</h2></div>{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
<section class="conversion-panel"><div><span class="eyebrow">꽃이랑 꽃선물 상담</span><h2>어떤 마음을 전하고 싶으신가요?</h2><p>받는 분과 선물할 날, 생각하신 예산을 편하게 말씀해 주세요. 상품과 가능한 전달 일정을 함께 상담하실 수 있습니다.</p></div><div class="actions"><a class="btn light" href={site.phoneHref}>전화주문</a><a class="btn yellow" href={site.orderUrl}>온라인 주문</a></div></section>
</BaseLayout>
