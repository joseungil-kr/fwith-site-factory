---
import {site} from '../config/site';
import {groupsFor,coverage as sourceCoverage} from '../lib/regional-runtime.mjs';
import InlineOrderBanner from './InlineOrderBanner.astro';
const {pages}=Astro.props;
type Representative={pageKey:string;unitKeys:string[]};
type District={key:string;name:string;sourceUrl:string};
type RegionEntry={representative:Representative;page:{url:string;primaryKeyword:string;cardSummary:string}};
type RegionGroup=District & {items:RegionEntry[]};
type Coverage={districts:District[];units:{unitKey:string;name:string}[];administrativeCrosswalk:{aliasKey:string;name:string;districtKey:string;relations:{unitKey:string;scope:string}[]}[]};
const coverage=sourceCoverage as Coverage;
const districts=groupsFor(pages) as RegionGroup[];
const published=new Map<string,RegionEntry>(districts.flatMap(d=>d.items).flatMap(entry=>entry.representative.unitKeys.map(key=>[key,entry] as [string,RegionEntry])));
---
<section class="category-hero">
  <span class="eyebrow">{site.brand} {site.region}</span>
  <h1>{site.region} 장소별 근조·축하화환</h1>
  <p>결혼하는 두 분의 앞날을 축복하고, 슬픔을 겪는 분께 위로를 전하고 싶은 마음. {site.region}의 예식장·장례식장·행사별 안내에서 꽃이랑 상품을 살펴보세요. 보내실 장소와 예산부터 편하게 상담하실 수 있습니다.</p>
  <div class="actions"><a class="btn primary" href={site.phoneHref}>전화 상담·주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
</section>
<nav class="actions" aria-label="지역 안내">{districts.map(d=><a class="btn light" href={`#${d.key}`}>{d.name}</a>)}</nav>
{districts.map((district,index)=><section id={district.key} data-region-district={district.key}>
  <div class="section-title"><h2>{district.name}</h2></div>
  <div class="card-grid big">{district.items.map(({representative,page})=><a class="page-card" href={page.url} data-region-unit={representative.unitKeys.join('|')}><strong>{page.primaryKeyword}</strong><span>{page.cardSummary}</span><em>상품과 꽃 이야기 보기 →</em></a>)}</div>
  {index===Math.floor((districts.length-1)/2) && <InlineOrderBanner/>}
  <details class="content-card"><summary>행정구역 이름으로 찾기</summary>
    <p>동 이름으로 찾으실 수 있도록 법정동 87개와 행정동 17개를 정리했습니다. 장소별 안내가 없는 곳은 ‘개별 안내 준비 중’, 여러 행정동에 걸친 곳은 ‘일부’로 표시합니다. 목록에 없는 장소도 전화로 문의하실 수 있으며, 실제 전달 가능 여부는 주문하실 주소와 일정에 따라 상담합니다.</p>
    <ul class="decision-list">{coverage.administrativeCrosswalk.filter(a=>a.districtKey===district.key).map(admin=><li data-administrative-unit={admin.aliasKey}><strong>{admin.name}</strong>: {admin.relations.map((relation,index)=>{
      const unit=coverage.units.find(unit=>unit.unitKey===relation.unitKey);
      const entry=published.get(relation.unitKey);
      if(!unit)throw new Error('Administrative relation lacks a legal unit');
      return <>{index>0?' · ':''}{entry ? <a href={entry.page.url}>{unit.name}</a> : <span>{unit.name} (개별 안내 준비 중)</span>}{relation.scope==='partial'?' 일부':''}</>;
    })}</li>)}</ul>
    <a href={district.sourceUrl} rel="nofollow">{district.name} 공식 관할 안내</a>
  </details>
</section>)}
