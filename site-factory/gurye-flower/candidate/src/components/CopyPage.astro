---
import BaseLayout from '../layouts/BaseLayout.astro';
import SharedFlowerBanner from './SharedFlowerBanner.astro';
import ProductCards from './ProductCards.astro';
import CopyBlocks from './CopyBlocks.astro';
import {copy,display,ui,sections} from '../lib/gurye-runtime.mjs';
const {page}=Astro.props;
const error=display.notFoundCopyPlan;
---
<BaseLayout page={page}><article data-page-id={page.id} data-source-manuscript-sha={copy.sourceSHA256['draft-home.ko.md']}>
{page.id==='home'?<>
<section id="opening" class="category-hero"><h1 data-copy-key="page.h1">{display.page.h1}</h1>{copy.intro.split('\n\n').map((p:string,i:number)=><p data-copy-key={`intro.${i}`}>{p}</p>)}<div class="actions">{ui.heroActions.map((a:any,i:number)=><a class={`btn ${i===0?'dark':'primary'}`} data-copy-key={`ui.heroActions.${i}`} href={a.href}>{a.label}</a>)}</div></section>
<SharedFlowerBanner variant="message"/>
{sections.map((s:any)=><>
<section id={s.id} class="content-card copy-section"><h2 data-copy-key={`section.${s.id}.heading`}>{s.heading}</h2>{s.id==='products-and-cost'?<><CopyBlocks blocks={s.blocks.slice(0,1)} prefix={`section.${s.id}.body`}/><ProductCards/><CopyBlocks blocks={s.blocks.slice(1)} prefix={`section.${s.id}.body`} offset={1}/></>:<CopyBlocks blocks={s.blocks} prefix={`section.${s.id}.body`}/>}</section>
{s.id==='products-and-cost'&&<SharedFlowerBanner variant="budget"/>}{s.id==='ribbon-and-order'&&<SharedFlowerBanner variant="consultation"/>}
</>)}
<section id="questions" class="faq" data-visible-faq><h2 data-copy-key="section.questions.heading">{copy.sections.find((s:any)=>s.id==='questions')?.heading}</h2>{copy.faq.map((f:any)=><div class="faq-pair" id={f.id}><h3 data-copy-key={`${f.id}.question`}>{f.question}</h3><p data-copy-key={`${f.id}.answer`}>{f.answer}</p></div>)}</section>
<div class="actions final-action"><a class="btn dark" data-copy-key="ui.closingAction" href={ui.closingAction.href}>{ui.closingAction.label}</a></div>
<section id="sources" class="source-card"><h2 data-copy-key="sources.heading">{display.sourceArea.heading}</h2><p data-copy-key="sources.checkedLabel">{display.sourceArea.checkedLabel}</p><ul>{display.sourceArea.items.map((s:any,i:number)=><li><a data-copy-key={`sources.${i}`} href={s.href}>{s.label}</a></li>)}</ul></section>
</>:<section class="category-hero not-found"><h1 data-copy-key="404.h1">{error.h1}</h1><p data-copy-key="404.body">{error.body}</p><div class="actions"><a class="btn dark" data-copy-key="404.ctaLabel" href={error.ctaHref}>{error.ctaLabel}</a></div></section>}
</article></BaseLayout>
