---
import SharedFlowerBanner from '../components/SharedFlowerBanner.astro';
import InlineOrderBanner from '../components/InlineOrderBanner.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCards from '../components/ProductCards.astro';
import pages from '../data/pages.json';
import products from '../data/products.json';
import {site,serviceGroups as groups} from '../config/site';
import {groupsFor,assertRegionalInput} from '../lib/regional-runtime.mjs';
assertRegionalInput(pages);
const districts:{key:string;name:string}[]=groupsFor(pages);
import {homeProducts} from '../lib/catalog.mjs';
import {hubGuides} from '../lib/hubs.mjs';
const featured=homeProducts(products);
const heroProducts=['funeral-basic','funeral-premium','congrats-basic','congrats-premium'].map(key=>products.find(p=>p.key===key)).filter(Boolean);
---
<BaseLayout title={"서대문구 화환 주문 | 꽃이랑"} description={"신촌장례식장 조의, 영천시장 개업, 문화체육회관 공연과 연세동문회관 결혼식. 소중한 사람에게 보낼 화환을 사진과 가격으로 살펴보세요."} canonicalPath="/" socialProduct={heroProducts[0] || products[0]}>
<section class="home-hero">
 <div class="hero-copy"><span class="eyebrow">{site.region} 꽃배달 · {site.brand}</span><h1>서대문에서 나누는 기쁨과 따뜻한 위로</h1><p>오랜 친구의 결혼을 축복하는 동문회관, 첫 손님을 맞는 영천시장 가게, 연습의 결실을 펼치는 공연장, 조용히 위로를 전하는 신촌장례식장. 서대문구에서 꽃을 보내려는 마음에 맞춰 실제 상품을 살펴보세요.</p>
 <div class="actions"><a class="btn primary" href={site.phoneHref}>☎ {site.phone} 전화주문</a><a class="btn dark" href={site.orderUrl}>온라인 주문</a></div>
 <div class="facts"><span>전화 {site.phoneOrderHours}</span><span>온라인 {site.onlineOrderHours} 접수</span><span>상품·예산 상담</span></div></div>
 <div class="hero-products" aria-label="근조·축하화환 상품">{heroProducts.map((p:any)=><a class="hero-product" href={p.orderUrl} data-product-family={p.family} data-product-key={p.key}><img src={p.img} alt={p.name} loading="eager" width="420" height="420"/><span>{p.name}<strong>{p.price.toLocaleString()}원</strong></span></a>)}</div>
</section>
<SharedFlowerBanner variant="message"/>
{groups.length>0 && <section class="purpose-navigation" data-purpose-navigation><div class="section-title"><span class="eyebrow">목적에 맞게 선택</span><h2>누구에게, 어디로 보내시나요?</h2></div><div class="purpose-grid">{groups.map(g=><a class="page-card purpose-card" href={g.url}><strong>{g.label}</strong><span>{hubGuides[g.cat].decision[0]}</span><em>상품·주문 준비 보기 →</em></a>)}</div></section>}
{districts.length>0 && <section class="purpose-navigation" data-region-navigation><div class="section-title"><h2>지역별 꽃배달 안내</h2><p>받는 곳의 동 이름과 장소에 맞는 주문 안내를 찾아보세요.</p></div><div class="purpose-grid">{districts.map(district=><a class="page-card purpose-card" href={`/regions/#${district.key}`}><strong>{district.name}</strong><span>받는 장소에 맞는 상품·주문 안내</span></a>)}</div><a href="/regions/">보낼 장소의 주문 안내 보기 →</a></section>}
<SharedFlowerBanner variant="budget"/>
<section class="product-section" data-home-selection><div class="section-title"><span class="eyebrow">{site.brand} 상품과 가격</span><h2>근조·축하화환 상품과 가격을 비교하세요</h2><p>사진과 기본가격을 나란히 살펴보며 예산에 맞는 화환을 골라보세요. 처음 주문하시거나 선택이 어렵다면 받는 장소와 전할 마음을 알려 주세요. 전화로 상품 선택과 주문 준비를 상담하실 수 있습니다.</p></div><ProductCards products={featured}/></section>
<SharedFlowerBanner variant="consultation"/>
<InlineOrderBanner/>
{groups.length>0 && <section class="hub-overview"><div class="section-title"><span class="eyebrow">장소와 상황별 상세 안내</span><h2>전달할 곳에 필요한 정보를 확인하세요</h2></div>{groups.map(g=><article class="hub-block"><div class="hub-heading"><h3>{g.label}</h3><a href={g.url}>전체 보기 →</a></div><div class="card-grid">{pages.filter((p:any)=>p.category===g.cat).map((p:any)=><a class="page-card" href={p.url}><strong>{p.primaryKeyword}</strong><span>{p.cardSummary}</span></a>)}</div></article>)}</section>}
</BaseLayout>
