          "if": "github.repository == 'joseungil-kr/fwith-site-factory' && github.ref == 'refs/heads/main'"
        },
        "publish": {
          "if": "inputs.indexnow_only != true"
        },
        "finalize_indexnow": {
          "if": "inputs.indexnow_only == true"
        }
      }
    }
  ]
}